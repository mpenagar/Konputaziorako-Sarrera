   "source": [
    "def taula_irakurri(bideizena, kodifikazioa=\"utf8\"):\n",
    "    f = open(bideizena, mode=\"r\", encoding=kodifikazioa)\n",
    "    z = []\n",
    "    for ilara in f:\n",
    "        z.append(list(ilara.rstrip()))\n",
    "    f.close()\n",
    "    return z"
   ]
  },
